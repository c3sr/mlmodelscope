# VLLM_BASE_URL=http://127.0.0.1:8000/v1
# VLLM_API_KEY=
CORS_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=8090
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_ATTACHMENTS=4

# Supported providers: gemini, openai, vllm, openai-compatible
EXPLANATION_PROVIDER=gemini
EXPLANATION_MODEL=gemini-3.6-flash
# EXPLANATION_BASE_URL=http://127.0.0.1:8000/v1
# EXPLANATION_API_KEY=
# EXPLANATION_RESPONSE_FORMAT=json_schema

# Provider-specific variables remain available for backward compatibility.
GEMINI_API_KEY=replace-with-server-side-key
GEMINI_MODEL=gemini-3.6-flash
# OPENAI_API_KEY=replace-with-server-side-key

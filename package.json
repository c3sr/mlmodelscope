{
  "name": "mlmodelscope",
  "version": "0.4.10",
  "private": true,
  "config-overrides-path": "/config-overrides.js",
  "dependencies": {
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^13.0.0",
    "@uppy/react": "^3.3.1",
    "file-type-checker": "^1.0.9",
    "react": "^18.3.1",
    "react-app-rewired": "^2.2.1",
    "react-compare-image": "^3.4.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "react-scripts": "5.0.1",
    "react-syntax-highlighter": "^15.5.0",
    "rxjs": "^7.8.1",
    "sass": "^1.77.2",
    "sass-loader": "^14.2.1",
    "typeface-lato": "1.1.13",
    "typeface-source-code-pro": "1.1.13",
    "uppy": "^3.25.3"
  },
  "scripts": {
    "start": "react-app-rewired start",
    "build": "react-app-rewired build",
    "copy:redirect": "cp ./_redirects build",
    "test": "react-app-rewired test --env=jsdom --setupFilesAfterEnv='./src/setupTests.js'",
    "eject": "react-scripts eject",
    "bundle": "npm-run-all clean:build build build:assets",
    "clean:build": "rimraf build",
    "build:assets": "node scripts/build_go_assets.js",
    "storybook": "start-storybook -p 6006 -s public",
    "build-storybook": "build-storybook -s public"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.24.1",
    "@storybook/addon-actions": "^8.1.1",
    "@storybook/addon-essentials": "^8.1.1",
    "@storybook/addon-links": "^8.1.1",
    "@storybook/node-logger": "^8.1.1",
    "@storybook/preset-create-react-app": "^8.1.1",
    "@storybook/react": "^8.1.1",
    "@svgr/webpack": "^8.1.0",
    "babel-plugin-import": "^1.13.8",
    "customize-cra": "^1.0.0",
    "eslint-config-prettier": "^9.1.0",
    "expect": "^29.7.0",
    "fetch-mock": "^9.11.0",
    "jest-environment-jsdom-fifteen": "^1.0.2",
    "lint-staged": "^15.2.2",
    "npm-run-all": "^4.1.5",
    "raw-loader": "^4.0.2",
    "react-error-overlay": "6.0.11",
    "rimraf": "^5.0.7"
  },
  "resolutions": {
    "//": "See https://github.com/facebook/create-react-app/issues/11773",
    "react-error-overlay": "6.0.9"
  },
  "overrides": {
    "react-refresh": "0.14.2"
  },  
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "eslint --fix",
      "prettier --parser flow --write",
      "git add"
    ],
    "src/**/*.css": [
      "stylefmt",
      "stylelint scss",
      "git add"
    ],
    "src/**/*.scss": [
      "stylefmt",
      "stylelint --syntax scss",
      "git add"
    ]
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "eslintConfig": {
    "overrides": [
      {
        "files": [
          "**/*.stories.*"
        ],
        "rules": {
          "import/no-anonymous-default-export": "off"
        }
      }
    ]
  },
  "volta": {
    "node": "14.21.3"
  }
}

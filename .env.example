# Make a copy of this called .env for local development environment
REACT_APP_API_URL=http://api.local.mlmodelscope.org
REACT_APP_EXPLANATION_API_URL=http://127.0.0.1:8090
REACT_APP_UPLOAD_DRIVER=local
REACT_APP_UPLOAD_URL=

# Set these only when running the S3/Companion upload service.
# REACT_APP_UPLOAD_DRIVER=s3
# REACT_APP_COMPANION_URL=http://companion.local.mlmodelscope.org
REACT_APP_IS_LOCAL=true
